# Immutable values below are optional mirrors of deployments/*.json. In production, when set,
# they MUST equal the tracked facts; development overrides are syntax-validated.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
RELAYER_STELLAR_SECRET=SFILL_ME_RELAYER_OWN_KEYPAIR
RELAYER_STELLAR_PUBLIC=GBVJ34MT4GDKZJGILI6DRYGD75ZNUBJGGZIDUV7IPFNVVDWGE5GBLV3X

# Base leg — relayer's OWN identity (submits public attested mints, not user funds)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
RELAYER_BASE_PRIVKEY=0xFILL_ME_RELAYER_OWN_EOA
ZERODEV_PROJECT_ID=FILL_ME
YIELD_ROUTER_ADDRESS=0xF80aa8F571E6d24Ea72F051Fc6F9A9C516727B6d

# CCTP
IRIS_URL=https://iris-api-sandbox.circle.com

# Public/server integration. HTTPS is mandatory in staging/production. Public origin is an
# origin only (no credentials/path/query/fragment); reporter URL may include its endpoint path.
RELAYER_PUBLIC_ORIGIN=http://localhost:8788
AGENT_INDEX_REPORTER_URL=http://localhost:5173/api/agent-index
AGENT_INDEX_REPORTER_SCHEMA=1
AGENT_INDEX_REPORTER_SECRET=FILL_ME

# Idempotency store (dev = JSON file; prod swaps to D1, see Task 2.2)
RELAYER_STORE_PATH=./.relayer-store.dev.json

# SQLite persistence (jobs + mandates + idempotency + the base-child association outbox survive
# restarts). Requires Node >= 22.5. When set, it overrides RELAYER_STORE_PATH for the idempotency
# store and backs jobs/mandates too.
#   dev/test  — optional. Without it there is no association outbox, so POST /farm answers
#               503 "Base child intent is unavailable" and the cross-chain leg is simply off.
#   PRODUCTION/STAGING — REQUIRED. config.mjs need()s it, and setting it is also what starts the
#               association outbox delivery worker (server.mjs startAssociationOutboxWorker).
# RELAYER_DB_PATH=./.relayer.dev.db

# Session keys stored in a durable relayer database must be encrypted at rest. The first key
# encrypts new rows; older keys remain temporarily available only to decrypt and rotate rows.
# RELAYER_SESSION_KEY_ENCRYPTION_KEYS=2026-08:<base64-32-bytes>,2026-07:<old-base64-32-bytes>

# Optional: shared secret the Cloudflare Pages proxy (functions/api/vf-cross) must send on
# x-vf-relayer-key. Empty = local dev (no gate). On the VM it MUST match Cloudflare Pages
# RELAYER_PROXY_KEY. Generate: openssl rand -hex 32
RELAYER_PROXY_KEY=FILL_ME

# Smoke-only: throwaway dev keypair SIMULATING the user's passkey signature until SP3 ships the
# real wallet. Never read by relayMint/dispatchDeposits in the production path.
SMOKE_STELLAR_SECRET=SFILL_ME
SMOKE_STELLAR_PUBLIC=GFILL_ME
SMOKE_SESSION_PRIVKEY=0xFILL_ME_EPHEMERAL_SESSION_KEY
# Optional: owner (sudo) key for the mandate. Defaults to RELAYER_BASE_PRIVKEY if unset.
# SMOKE_OWNER_PRIVKEY=0x...
# Generate by running: node --env-file=.dev.vars smoke/mint-mandate.mjs  (paste its output line here)
SMOKE_SESSION_APPROVAL=FILL_ME_RUN_smoke/mint-mandate.mjs_TO_GENERATE
