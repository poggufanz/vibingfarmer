# deploy/.env.example — copy to deploy/.env on the VM (root-only: chmod 600). NEVER commit .env.
# --- relayer ---
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
RELAYER_STELLAR_SECRET=S...
RELAYER_STELLAR_PUBLIC=G...
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
RELAYER_BASE_PRIVKEY=0x...
ZERODEV_PROJECT_ID=...
YIELD_ROUTER_ADDRESS=0xF80aa8F571E6d24Ea72F051Fc6F9A9C516727B6d
IRIS_URL=https://iris-api-sandbox.circle.com
RELAYER_PROXY_KEY=<same value as Cloudflare Pages RELAYER_PROXY_KEY — openssl rand -hex 32>
# Session-key envelope keyring (REQUIRED whenever RELAYER_DB_PATH is set — compose always
# sets it, so a missing keyring crashes boot with RELAYER_STARTUP_FAILED). Format
# keyId:base64(32B), first entry is active. Generate: node --input-type=module -e "import{randomBytes}from'node:crypto';process.stdout.write('k1:'+randomBytes(32).toString('base64'))"
RELAYER_SESSION_KEY_ENCRYPTION_KEYS=k1:REPLACE_WITH_GENERATED_KEY
# --- radar (lifeboat) ---
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VAULT_ADDRESS=CDWHNHIHOGBPXAK23NCU37BCXRRHCNNCEG6IPE4Q7FXBYLTJ7UYYKM77
POOL_1=CCEBVDYM32YNYCVNRXQKDFFPISJJCV557CDZEIRBEE4NCV4KHPQ44HGF
USDC=CAQCFVLOBK5GIULPNZRGATJJMIZL5BSP7X5YJVMGCPTUEPFM4AVSRCJU
STELLAR_KEEPER_SECRET=S...
LIFEBOAT_REF_URLS=https://api.coingecko.com/api/v3/simple/price?ids=usd-coin&vs_currencies=usd#usd-coin.usd
# --- tunnel ---
CLOUDFLARED_TUNNEL_TOKEN=<from the Cloudflare Zero Trust tunnel dashboard>
