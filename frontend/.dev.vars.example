# Local secrets for `wrangler pages dev` (Cloudflare's local Functions runtime).
# Copy to `frontend/.dev.vars` (gitignored) and fill in. These mirror the
# server-side (NON-VITE_) vars in .env.example — they are read by the /api/*
# Pages Functions via context.env → process.env, never bundled to the client.
#
# In production set the SAME keys as encrypted env vars in the Cloudflare Pages
# dashboard (Settings → Variables and Secrets), or via `wrangler pages secret put`.

# Mark this local Pages Functions runtime as development so localhost origins are available.
NODE_ENV=development

# Origin allowlist for the /api/* proxies. Set to your Pages URL(s), comma-separated.
# e.g. https://vibing-farmer.pages.dev,https://your-custom-domain.com
ALLOWED_ORIGIN=http://localhost:5173
ALLOWED_EXTENSION_ORIGINS=

# DeepSeek — server-side AI key (read by /api/ai). OPTIONAL / host-funded.
# The app is BYOK-first (users paste their own key in Settings). Set this only for an
# out-of-box "host demo key" that anonymous visitors spend. LOCKDOWN: do NOT set it in
# the Cloudflare Pages dashboard → /api/ai 503s → app uses the deterministic fallback.
DEEPSEEK_API_KEY=sk-your_deepseek_key

# Tavily web search — server-side key (read by /api/search). OPTIONAL / host-funded,
# same BYOK model. Leave unset on a lockdown deploy; users can bring their own Tavily key.
TAVILY_API_KEY=tvly-...

# ─── Soroban gasless relay (read by /api/stellar-relay) ───
# Relayer keypair SECRET (S...). Server-only — never expose to the client bundle.
# Generate + fund on testnet:  stellar keys generate relayer --network testnet --fund
# then read the secret with:    stellar keys show relayer
STELLAR_RELAYER_SECRET=S...
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SOROBAN_VAULT_ADDRESS=CDWHNHIHOGBPXAK23NCU37BCXRRHCNNCEG6IPE4Q7FXBYLTJ7UYYKM77

# Canonical production relay and receipt-authority lists, in deployment-fact order: live V2 first,
# then V1 compatibility. Production rejects a different order or value. These agent WASM hashes
# are the corresponding live bridge/deposit generations; there is no deployed V3/V4 release hash.
SOROBAN_ROUTER_ADDRESSES=CB675TTSFM6COTGHGB7K2I7IODPQ3HTHOTTTXU2LJHXXNGTS45NOTRSE,CCEWWRQVYKEIWTO7GTX2QVHQASC3GIQOZZTDMGTOHFQYKZIX5KJ6CYE5
SOROBAN_AGENT_WASM_HASHES=1fdbe175ddeb6d237a178c3c117b4e6c168122eec7d94f06a4b27ee4026efbe1,d61ceaaaf5a3fd9fd25987eba0f843ccb79880f3eaa137e066b5f63ab9eaa2ba

# Singular V1 compatibility fallback for older deployments/readers. The plural V2,V1 list wins.
SOROBAN_ROUTER_ADDRESS=CCEWWRQVYKEIWTO7GTX2QVHQASC3GIQOZZTDMGTOHFQYKZIX5KJ6CYE5

# exit_router for the one-popup full-exit sweep (VF Wallet Task 5); unset = sweep relaying
# disabled (fail closed — exit.js's per-agent owner_withdraw rollback path still works direct).
SOROBAN_EXIT_ROUTER_ADDRESS=CDGDIPHBN3MSNURDX33IZBXXQTJPT7THAXSMVBAIOIXLOA6OF32IRS2J

# Agents the relay will sponsor F11 exit-leg-2 token.transfer calls for (comma-separated,
# exact match, fail-closed if empty). Demo agent + your local smoke agent (SMOKE_AGENT_ADDRESS):
SOROBAN_AGENT_ALLOWLIST=CCY452UMBSDG4VHHECJAW3T5Q5BUK5NJUK22IDI2MQBHAZLTIM256UAC,C...

# Testnet token faucet (server-only; leave unset to disable /api/faucet with 503)
VF_FAUCET_SECRET=S...                    # vf-deployer secret; treasury must hold testnet Blend USDC
SOROBAN_TOKEN_ADDRESS=CAQCFVLOBK5GIULPNZRGATJJMIZL5BSP7X5YJVMGCPTUEPFM4AVSRCJU

# Optional: trusted proxy hops for rate-limit client-IP resolution.
# Cloudflare sets CF-Connecting-IP (mapped to x-real-ip by the adapter), so the
# default 1 is fine; only change if you front Pages with another proxy.
TRUST_PROXY_HOPS=1

# ─── VF API gate (SEP-10 portal + gateway) ───
VF_AUTH_SIGNING_KEY=S...        # server SEP-10 signing keypair secret (testnet)
VF_JWT_SECRET=change-me-32-chars-min
VF_HOME_DOMAIN=localhost:5173   # SEP-10 home_domain / web_auth_domain
VF_GLOBAL_DAILY_CAP=5000        # global upstream budget per scope per day

# ─── On-ramp widget (SP4, read by /api/onramp-session) ───
# Server-only. Get keys from the Transak Partner Dashboard: https://dashboard.transak.com
TRANSAK_API_KEY=your_transak_api_key
TRANSAK_ACCESS_TOKEN=your_transak_access_token
TRANSAK_ENVIRONMENT=STAGING
TRANSAK_REFERRER_DOMAIN=vibing-farmer.pages.dev

# Cross-chain relayer proxy (production). Tunnel hostname of the relayer VM + the shared secret
# the relayer requires on x-vf-relayer-key (must equal the VM's RELAYER_PROXY_KEY).
RELAYER_ORIGIN=http://localhost:8788
RELAYER_PROXY_KEY=change-me

# ─── Agent index historical backfill (Pocket Crew My Money Task 4, read by
# scripts/agent-index/backfill-legacy-agents.mjs) ───
# Archival Soroban RPC/events provider (implements the same getEvents contract the live indexer
# uses, Task 3) — full retention back to ledger 1, unlike the short-retention public RPC above.
# Server-only: even when the provider needs no credentials, this stays out of the client bundle
# (never VITE_). Leave unset to run the backfill script with router/registry archival sources
# honestly reported unavailable (--dry-run still works; the audit lands on 'partial').
AGENT_INDEX_ARCHIVAL_RPC_URL=

# ─── Agent index ingest gate (read by api/agent-index.js, checked in api/agent-index/handler.js) ───
# Shared secret the POST /api/agent-index?action=ingest endpoint requires as an Authorization Bearer;
# scripts/agent-index/backfill-legacy-agents.mjs reads the same name and refuses to write without it.
# Compared with a constant-time equality check. Server-only (never VITE_). FAILS CLOSED: while this
# is unset the ingest endpoint answers 503 "Agent index ingest not configured" and indexes nothing —
# reads are unaffected, so an unset value is a safe default, not a broken one.
AGENT_INDEX_INGEST_SECRET=

# ─── Agent index reporter gate (read by api/agent-index.js, checked in api/agent-index/handler.js
# reporterGate) ───
# Shared secret the relayer sends as an Authorization Bearer on every execution-receipt, base-child
# intent, lifecycle and `action=base-child-ready` write. Must equal the VM's
# AGENT_INDEX_REPORTER_SECRET. Constant-time compared. Server-only (never VITE_) — the browser never
# receives it and never calls a D1 write directly. FAILS CLOSED in both directions: unset here, every
# reporter route answers 503 "Agent-index writer is not configured", and a production relayer will
# not open its listener at all because its boot readiness probe hits that same route.
# Generate: openssl rand -hex 32
AGENT_INDEX_REPORTER_SECRET=

# Signs read-only owner pagination cursors. Server-only; use at least 32 random bytes.
AGENT_INDEX_CURSOR_SECRET=

# D1 binding: these routes need the `VF_DB` binding (see wrangler.jsonc) with migrations 0001-0007
# applied. Migration 0007 adds the immutable membership guard and owner-page index. Migrations 0005
# (execution receipts) and 0006 (base child intents) are required before a production relayer can
# boot — see "Release prerequisites" in GETTING_STARTED.md.
